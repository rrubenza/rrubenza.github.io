 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"thetas", "[", "i", "]"}], "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Theta]", "[", "i", "]"}], "[", "t", "]"}], "/.", "sol"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"xpos", "[", "j", "]"}], "[", "t_", "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"a", "*", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"thetas", "[", "i", "]"}], "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "j"}], "}"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ypos", "[", "j", "]"}], "[", "t_", "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"a", "*", 
        RowBox[{"Cos", "[", 
         RowBox[{
          RowBox[{"thetas", "[", "i", "]"}], "[", "t", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "j"}], "}"}]}], "]"}], "]"}]}], ",", 
